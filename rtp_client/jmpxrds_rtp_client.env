# Environment file to accompany the systemd .service file

#  -l, --latency=200                 Amount of ms to buffer in the jitterbuffers
LATENCY=200

#  -h, --remote-host=                Address of host where JMPXRDS runs (RTCP is sent there)
REMOTE_HOST="127.0.0.1"

#  -p, --remote-base-port=5000       Base port of JMPXRDS: RTP is received on PORT,
#                                    RTCP on PORT+1 and RTCP is sent to REMOTE_HOST:PORT+2
PORT=5000

#  -d, --device=default              ALSA device to output the FM signal to
DEVICE="hw:CARD=ODROIDDAC,DEV=0"
